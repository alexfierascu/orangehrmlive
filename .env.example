# Copy to `.env` and fill in. `.env` is git-ignored.
# Required env vars throw at startup if missing — no silent defaults for credentials.

# Optional — defaults to the public OrangeHRM demo if not set.
BASE_URL=https://opensource-demo.orangehrmlive.com

# Required — the admin credentials used by the global setup project.
# For the public demo these are printed on the login page itself.
ADMIN_USER=
ADMIN_PASSWORD=
